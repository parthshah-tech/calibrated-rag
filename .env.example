# LLM (optional): without a key the app returns sources only. Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low

DATA_DIR=./data
# recursive | fixed
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# sentence-transformers | hash (hash is an offline stand-in for tests, never for reported results)
EMBEDDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2
# overlap | rbo | tau
CONFIDENCE_METRIC=rbo
CONFIDENCE_K=10
CANDIDATE_POOL=50
RRF_K=60
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=20

# Badge cutoffs (fit them on your own documents; see docs/study.md)
CONFIDENCE_LOW=0.3
CONFIDENCE_HIGH=0.6

# Study mode (off by default; see docs/study.md and docs/deploy.md)
STUDY_MODE=0
STUDY_QUESTIONS=study/questions.json
STUDY_FROZEN=
STUDY_DB=./data/study.sqlite
STUDY_TIME_BUDGET_MIN=35
STUDY_ADMIN_TOKEN=
STUDY_SALT=
